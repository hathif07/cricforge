PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://10.169.127.39:5173

# Leave MONGODB_URI unset to auto-fallback to a local Mongo instance, and
# finally to an in-memory MongoDB (see config/db.js) so the app can boot
# with zero configuration for grading/demo purposes.
MONGODB_URI=mongodb://127.0.0.1:27017/cricforge

JWT_ACCESS_SECRET=cricforge_jwt_access_secret_2024
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=cricforge_jwt_refresh_secret_2024
JWT_REFRESH_EXPIRY=7d
